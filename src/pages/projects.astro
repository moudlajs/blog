---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import { SITE } from "@/config";
import { PROJECTS, getLatestRelease } from "@/data/projects";

const projects = await Promise.all(
  PROJECTS.map(async p => ({ ...p, release: await getLatestRelease(p.repo) }))
);
---

<Layout title={`Projects | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="Projects"
    pageDesc="Things I build after hours. All open source, all scratching my own itch."
  >
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {
        projects.map(p => (
          <li class="flex flex-col rounded-lg border border-border p-5 transition-colors hover:border-accent">
            <div class="mb-2 flex items-baseline justify-between gap-3">
              <h2 class="text-lg font-semibold text-accent">
                <a
                  href={`https://github.com/${p.repo}`}
                  class="hover:underline hover:decoration-dashed hover:underline-offset-4"
                >
                  {p.name}
                </a>
              </h2>
              {p.release && (
                <span class="font-mono text-xs whitespace-nowrap opacity-70">
                  {p.release}
                </span>
              )}
            </div>
            <p class="mb-4 text-sm leading-relaxed">{p.description}</p>
            <div class="mt-auto flex flex-wrap items-center gap-2 border-t border-border pt-3">
              {p.tags.map(tag => (
                <span class="rounded-md bg-muted px-2 py-0.5 font-mono text-xs">
                  {tag}
                </span>
              ))}
              {p.live && (
                <a
                  href={p.live}
                  class="ms-auto font-mono text-xs text-accent underline decoration-dashed underline-offset-4"
                >
                  live →
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
