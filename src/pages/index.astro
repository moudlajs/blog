---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import IconRss from "@/assets/icons/IconRss.svg";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-4 pb-8">
      <p class="text-lg leading-relaxed">
        Hey, I'm Dan. DevOps engineer by day, fantasy football degenerate by...
        also day, honestly. I write about infrastructure, weird bugs that
        shouldn't exist, the side projects I build after hours, and why my
        waiver wire strategy needs work. Supervised by my dog's disapproving
        stares.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-1 gap-y-2">
        <Socials />
        <a
          href="/rss.xml"
          class="p-2 hover:rotate-6 sm:p-1"
          aria-label="Subscribe via RSS"
          title="Subscribe via RSS"
        >
          <IconRss
            class="inline-block size-6 stroke-accent stroke-2 sm:scale-110"
          />
        </a>
      </div>
    </section>

    <Hr />

    {
      sortedPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-12">
          <h2 class="text-xl font-semibold tracking-tight">Recent posts</h2>
          <ul>
            {sortedPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
          <LinkButton
            href="/posts/"
            class="font-mono text-sm hover:text-accent"
          >
            All posts
            <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
          </LinkButton>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
